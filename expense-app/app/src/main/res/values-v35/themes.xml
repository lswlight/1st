<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 부터는 화면이 상단 끝까지 그려져(edge-to-edge) 내용이 가려지므로, 기존처럼 상태 표시줄 아래부터 그리게 한다 -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#2F9E6E</item>
        <item name="android:colorAccent">#2F9E6E</item>
        <item name="android:statusBarColor">#FBF7F0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">#FBF7F0</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
